# =========================================================
# [서버 기본 환경 설정]
# =========================================================
PORT=5000
NODE_ENV=production

# 프런트엔드 CORS 허용 주소 (Vercel 도메인 및 로컬 주소)
CLIENT_URL=*

# =========================================================
# [Vercel CLI & 배포 토큰 설정]
# =========================================================
# Vercel 개인 엑세스 토큰 (https://vercel.com/account/tokens 에서 발급)
# CLI 명령어: vercel --token $VERCEL_ACCESS_TOKEN
VERCEL_ACCESS_TOKEN=your_vercel_access_token_here
VERCEL_TOKEN=your_vercel_access_token_here

# (선택) Vercel 프로젝트 및 조직(팀) ID
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# =========================================================
# [Supabase 클라우드 & CLI 접근 토큰 설정]
# =========================================================
# Supabase 프로젝트 기본 URL (대시보드 -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase 프로젝트 참조 ID (Project Ref: 예: abcdefghijklmno)
SUPABASE_PROJECT_ID=your_project_ref_here

# Supabase 공개키 (Anon Public Key)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABSE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase 비공개키 (Service Role Secret Key - 백엔드 서버 전용 비밀키)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABSE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase 개인 엑세스 토큰 (Personal Access Token - CLI 로그인용)
# 발급 위치: https://supabase.com/dashboard/account/tokens
# CLI 로그인: npx supabase login --token $SUPABASE_ACCESS_TOKEN
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here

# (선택) Supabase PostgreSQL 데이터베이스 직접 접속 비밀번호
SUPABASE_DB_PASSWORD=your_database_password_here

# =========================================================
# [관리자(Admin) 계정 설정]
# =========================================================
ADMIN_NAME=bodyguard
ADMIN_EMAIL=iicbruce@naver.com
ADMIN_PASSWORD=admin660520!

# =========================================================
# [보안 & JWT 세션 시크릿]
# =========================================================
JWT_SECRET=super_secret_jwt_key_2026_community_admin_secure!
SESSION_EXPIRY=24h
BCRYPT_SALT_ROUNDS=10
