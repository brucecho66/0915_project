# 서버 포트 설정
PORT=5000

# 환경 설정 (development / production)
NODE_ENV=production

# 프런트엔드 CORS 허용 주소 (Vercel 도메인 및 로컬 개발 주소)
# 예: https://your-frontend.vercel.app,http://localhost:5173
CLIENT_URL=*

# ==========================================
# [Supabase 클라우드 데이터베이스 설정]
# Supabase 대시보드 -> Project Settings -> API 에서 확인 가능
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
# 백엔드 서버용 Service Role Key (모든 테이블 권한을 가짐, 절대 외부에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 보조 공개 키 (Anon Key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# [관리자(Admin) 계정 설정]
# ==========================================
ADMIN_NAME=bodyguard
ADMIN_EMAIL=iicbruce@naver.com
ADMIN_PASSWORD=admin660520!

# ==========================================
# [보안 & 세션 시크릿 (JWT / Session Secret)]
# ==========================================
JWT_SECRET=super_secret_jwt_key_2026_community_admin_secure!
SESSION_EXPIRY=24h
BCRYPT_SALT_ROUNDS=10
