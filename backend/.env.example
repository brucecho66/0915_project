# 서버 포트 설정
PORT=5000

# SQLite 데이터베이스 파일 경로
DB_PATH=./database.sqlite

# 환경 설정 (development / production)
NODE_ENV=development

# 프런트엔드 CORS 허용 주소 (Vite 기본 포트: 5173)
CLIENT_URL=http://localhost:5173

# 관리자(Admin) 계정 설정
ADMIN_EMAIL=admin@community.com
ADMIN_PASSWORD=admin1234!
ADMIN_USERNAME=최고관리자

# 보안 & 세션 시크릿 (JWT / Session Secret)
JWT_SECRET=super_secret_jwt_key_2026_community_admin_secure!
SESSION_EXPIRY=24h
BCRYPT_SALT_ROUNDS=10
